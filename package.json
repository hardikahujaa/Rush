{
  "name": "rush",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "hold-test": "tsx --conditions=react-server --env-file=.env.local scripts/hold-test.ts",
    "expiry-test": "tsx --conditions=react-server --env-file=.env.local scripts/expiry-test.ts",
    "ratelimit-test": "tsx --conditions=react-server --env-file=.env.local scripts/ratelimit-test.ts",
    "ratelimit-shared": "tsx --conditions=react-server --env-file=.env.local scripts/ratelimit-shared-state.ts",
    "expire-hold": "tsx --conditions=react-server --env-file=.env.local scripts/expire-hold.ts",
    "countdown-test": "tsx --conditions=react-server --env-file=.env.local scripts/countdown-test.ts",
    "release-test": "tsx --conditions=react-server --env-file=.env.local scripts/release-test.ts",
    "checkout-test": "tsx --conditions=react-server --env-file=.env.local scripts/checkout-test.ts",
    "webhook-test": "tsx --conditions=react-server --env-file=.env.local scripts/webhook-test.ts",
    "race-test": "tsx --conditions=react-server --env-file=.env.local scripts/race-test.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
