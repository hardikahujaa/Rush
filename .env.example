# ─── Database (Supabase → Project Settings → Database) ──────────────────────
# Runtime connection. Use the TRANSACTION POOLER string (port 6543) — serverless
# functions open many short-lived connections and would exhaust a direct pool.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
# Migrations only. Use the DIRECT / SESSION string (port 5432) — schema changes
# need a real session, which the transaction pooler cannot give you.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# ─── Supabase API (Project Settings → API) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SERVER ONLY. Never expose this to the browser — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Upstash Redis ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Stripe (test mode) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# NOTE: the local Stripe CLI secret and the production one are DIFFERENT.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── App secrets (generate your own) ────────────────────────────────────────
# Signs the waiting-room admission cookie (T34). Without it the queue is
# DISABLED rather than open - an unsigned admission would be a forgery hole.
#   openssl rand -hex 32
QUEUE_SIGNING_SECRET=
# How many people may be inside one event's seat map at once. Set it to 1 to
# watch a real line form across two browsers.
QUEUE_CAPACITY=50
QR_SIGNING_SECRET=""
CRON_SECRET=""
# Bearer token for POST /api/demo/reset (T47) - typed from a terminal right
# before a demo starts. Unset means nobody can authenticate with it, same
# fail-closed rule as CRON_SECRET; the floating button works without it, via
# the organizer role check instead.
#   openssl rand -hex 32
DEMO_RESET_SECRET=""

# ─── Email / monitoring ─────────────────────────────────────────────────────
RESEND_API_KEY=""

# Sentry (T45). Entirely optional - Sentry.init() with no DSN is a documented
# no-op, same posture as the Redis block above. Vercel Analytics needs no env
# var at all; it only sends anything when actually served by Vercel.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps during `next build`. Leave unset locally -
# the Sentry webpack plugin skips the upload step on its own when it is.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
